<?xml version="1.0" encoding="utf-8"?>
<!-- play / pause: green gradient circle with a touch ripple (2.6.2) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/brand_green_end"
                android:startColor="@color/brand_green"
                android:type="linear" />
        </shape>
    </item>
</ripple>
