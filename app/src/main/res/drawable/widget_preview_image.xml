<?xml version="1.0" encoding="utf-8"?>
<!-- the widget picker's preview below Android 12 (Android 12+ shows @layout/widget_preview) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_background_on" />
            <corners android:radius="16dp" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:drawable="@drawable/ic_widget_mutify_on"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp" />
</layer-list>
